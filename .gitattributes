* text=auto
*.md text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
# Keep every original byte, including encoding, line endings, and whitespace.
**/originals/** -text -whitespace
# VB6 project files need Windows line endings when checked out.
trojan-builder-configuration/source/*.vbp text eol=crlf
trojan-builder-configuration/source/*.vbg text eol=crlf
trojan-builder-configuration/source/*.frm text eol=crlf
trojan-builder-configuration/source/*.bas text eol=crlf
# Preserve the historical prototype source and binary resources exactly.
vb6-security-prototypes/** -text -whitespace
vb6-security-prototypes/**/README.md text eol=lf
